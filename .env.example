# Copia este archivo a .env y cambia los valores antes de iniciar los servicios.
# .env esta ignorado por Git. No guardes secretos reales en el repositorio.

# MinIO
MINIO_ROOT_USER=sismowatch
MINIO_ROOT_PASSWORD=change-me-minio-local
MINIO_BUCKET=sismowatch
MINIO_ACCESS_KEY=sismowatch
MINIO_SECRET_KEY=change-me-minio-local
MINIO_ENDPOINT=http://minio:9000
MINIO_ENDPOINT_HOST=minio:9000
MINIO_SECURE=false

# Airflow: PostgreSQL exclusivo para metadatos de Airflow.
AIRFLOW_DB_PASSWORD=change-me-airflow-db-local
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-airflow-admin-local
AIRFLOW_ADMIN_EMAIL=admin@example.local

# PostgreSQL operativo de SismoWatch (solo esquema ops; los sismos viven en MinIO).
SISMOWATCH_DB_HOST=sismowatch-db
SISMOWATCH_DB_PORT=5432
SISMOWATCH_DB_NAME=sismowatch
SISMOWATCH_DB_USER=sismowatch
SISMOWATCH_DB_PASSWORD=change-me-sismowatch-db-local

# USGS
USGS_MIN_MAGNITUDE=2.5
HISTORICAL_DAYS=30
USGS_TIMEOUT_SECONDS=30

# Spark
SPARK_MASTER_URL=spark://spark-master:7077

# API y dashboard
SISMOWATCH_API_URL=http://api:8000
API_KEY=change-me-api-key-local

# Agente de IA (Ollama local o LLM compatible con OpenAI). Sin clave ni URL, usa el modo local determinista.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=45
AGENT_LLM_API_KEY=ollama
AGENT_LLM_BASE_URL=http://host.docker.internal:11434/v1
AGENT_LLM_MODEL=qwen2.5:3b
